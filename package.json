{
  "name": "vespera",
  "productName": "Vespera",
  "version": "0.16.1",
  "description": "Vespera (VSP) — glass terminal for Polymarket MA200/MA20. Paper first.",
  "author": "VadimChudin",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/main/strategy.test.js && node src/main/engine.test.js && node src/main/brokers/polymarket.test.js && node src/main/persistence.test.js && node src/main/quotes.test.js && node src/main/risk.test.js && node src/main/safeguards.test.js && node src/main/connect.test.js && node src/main/export.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --mac",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "release": "electron-builder --win --mac --publish never"
  },
  "build": {
    "appId": "trade.vespera.app",
    "productName": "Vespera",
    "copyright": "Copyright © Vespera",
    "artifactName": "Vespera-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vespera",
      "uninstallDisplayName": "Vespera"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Vespera-${version}-mac.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ethers": "^5.7.2",
    "https-proxy-agent": "^7.0.6",
    "lightweight-charts": "^4.2.3",
    "ws": "^8.18.3"
  }
}
