(* 4 регистра, адрес = 100 + (номер-1)*4 *)
TYPE ST_RouteHmi :
STRUCT
    wCmd      : WORD;  (* +0 маски GVL_Const.RC_* *)
    wSts      : WORD;  (* +1 маски GVL_Const.RS_* *)
    iNotReady : INT;   (* +2 причина отказа в пуске: 1..37 механизм, 101..105 клапан, 201..207 бункер,
                          -1 общая авария/цепь управления, -2 конфликт маршрутов, -3 ошибка конфигурации *)
    iState    : INT;   (* +3 0 стоп, 1 предпусковой сигнал, 2 перевод клапанов, 3 работа, 4 останов *)
END_STRUCT
END_TYPE
