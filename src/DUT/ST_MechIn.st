(* Логические входы механизма (после учёта полярности в PRG_Inputs) *)
TYPE ST_MechIn :
STRUCT
    xQF       : BOOL;    (* 1 = автомат включен *)
    xDKS      : BOOL;    (* импульсы/уровень датчика контроля скорости *)
    xDSL1     : BOOL;    (* 1 = лента в норме *)
    xDSL2     : BOOL;
    xDP       : BOOL;    (* 1 = подпора нет *)
    xLocal    : BOOL;    (* 1 = ключ поста в положении "ручн." (местное управление) *)
    xLocStart : BOOL;    (* кнопка "Пуск" поста, НО *)
    xLocStop  : BOOL;    (* 1 = кнопка "Стоп" поста не нажата (НЗ) *)
    xEStop    : BOOL;    (* 1 = аварийный/концевой стоп не нажат (НЗ) *)
    xFcFault  : BOOL;    (* 1 = авария ПЧ *)
    xFcReady  : BOOL;    (* 1 = готовность/работа ПЧ *)
    xFb1      : BOOL;    (* заслонка: открыта;  фотосепаратор: статус "работа" *)
    xFb2      : BOOL;    (* заслонка: закрыта;  фотосепаратор: внешнее управление *)
    xErr      : BOOL;    (* фотосепаратор: критическая ошибка *)
    xLocOpen  : BOOL;    (* заслонка: кнопка "Открыть" поста *)
    xLocClose : BOOL;    (* заслонка: кнопка "Закрыть" поста *)
    xAux      : BOOL;    (* фотосепаратор: компрессор в работе (автомат включен) *)
END_STRUCT
END_TYPE
