TYPE ST_MechOut :
STRUCT
    qRun    : BOOL;      (* пуск двигателя / пуск ПЧ *)
    qPower  : BOOL;      (* включить питание ПЧ (сетевой контактор) *)
    qReset  : BOOL;      (* сброс аварии ПЧ, импульс *)
    qOpen   : BOOL;      (* заслонка: открыть *)
    qClose  : BOOL;      (* заслонка: закрыть *)
    qOn     : BOOL;      (* фотосепаратор: импульс "Включить" *)
    qOff    : BOOL;      (* фотосепаратор: импульс "Выключить" *)
    qEnable : BOOL;      (* фотосепаратор: разрешить секции 1-3 *)
END_STRUCT
END_TYPE
