[Unit]
Description=Vespera local health and resource monitor
After=vespera.service

[Service]
Type=oneshot
User=vespera
Group=vespera
Environment=VESPERA_DATA_DIR=/var/lib/vespera
Environment=VESPERA_HEALTH_URL=http://127.0.0.1:8787/healthz
ExecStart=/usr/bin/node /opt/vespera/scripts/operations-monitor.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/vespera
StandardOutput=journal
StandardError=journal
